    <SetProperty Action="SetKmLegacyCefRoyalRoot"
                 Id="KmLegacyCefRoyalRoot"
                 Value="[ProgramFiles64Folder]Royal Sword Calculator"
                 Sequence="execute"
                 After="AppSearch" />
    <SetProperty Action="SetKmLegacyCefPokemonRoot"
                 Id="KmLegacyCefPokemonRoot"
                 Value="[ProgramFiles64Folder]Pokemon Royal Sword"
                 Sequence="execute"
                 After="SetKmLegacyCefRoyalRoot" />
    <SetProperty Action="SetKmLegacyCefRoyalNestedRoot"
                 Id="KmLegacyCefRoyalNestedRoot"
                 Value="[ProgramFiles64Folder]Pokemon Royal Sword\Royal Sword Calculator"
                 Sequence="execute"
                 After="SetKmLegacyCefPokemonRoot" />
    <SetProperty Action="SetKmLegacyCefRoyalCanonicalUninstallCommand"
                 Id="KmLegacyCefRoyalCanonicalUninstallCommand"
                 Value="&quot;[ProgramFiles64Folder]Royal Sword Calculator\Uninstall Royal Sword Calculator.exe&quot; /allusers"
                 Sequence="execute"
                 After="SetKmLegacyCefRoyalNestedRoot" />
    <SetProperty Action="SetKmLegacyCefPokemonCanonicalUninstallCommand"
                 Id="KmLegacyCefPokemonCanonicalUninstallCommand"
                 Value="&quot;[ProgramFiles64Folder]Pokemon Royal Sword\Uninstall Pokemon Royal Sword.exe&quot; /allusers"
                 Sequence="execute"
                 After="SetKmLegacyCefRoyalCanonicalUninstallCommand" />
    <SetProperty Action="SetKmLegacyCefRoyalAtPokemonUninstallCommand"
                 Id="KmLegacyCefRoyalAtPokemonUninstallCommand"
                 Value="&quot;[ProgramFiles64Folder]Pokemon Royal Sword\Uninstall Royal Sword Calculator.exe&quot; /allusers"
                 Sequence="execute"
                 After="SetKmLegacyCefPokemonCanonicalUninstallCommand" />
    <SetProperty Action="SetKmLegacyCefRoyalNestedUninstallCommand"
                 Id="KmLegacyCefRoyalNestedUninstallCommand"
                 Value="&quot;[ProgramFiles64Folder]Pokemon Royal Sword\Royal Sword Calculator\Uninstall Royal Sword Calculator.exe&quot; /allusers"
                 Sequence="execute"
                 After="SetKmLegacyCefRoyalAtPokemonUninstallCommand" />
    <SetProperty Action="ValidateKmLegacyCefRoyalPayload"
                 Id="KmLegacyCefRoyalPayloadValidated"
                 Value="1"
                 Sequence="execute"
                 After="SetKmLegacyCefRoyalNestedUninstallCommand"
                 Condition="KM_REMOVE_LEGACY = 1 AND KM_LEGACY_CEF_VALID = 1 AND KmLegacyCefDisplayName = &quot;Royal Sword Calculator&quot; AND KmLegacyCefAppArchive AND KmLegacyCefUpdaterConfig AND ((KmLegacyCefPublisher = &quot;KotMatrosk1n&quot; AND ((KmLegacyCefDisplayVersion = &quot;0.1.3&quot; AND KmLegacyRoyalMainElectron AND KmLegacyRoyalUninstall013) OR (KmLegacyCefDisplayVersion = &quot;0.1.4&quot; AND KmLegacyRoyalMainElectron AND KmLegacyRoyalUninstall014) OR (KmLegacyCefDisplayVersion = &quot;0.1.5&quot; AND KmLegacyRoyalMainElectron AND KmLegacyRoyalUninstall015) OR (KmLegacyCefDisplayVersion = &quot;0.1.6&quot; AND KmLegacyRoyalMainElectron AND KmLegacyRoyalUninstall016) OR (KmLegacyCefDisplayVersion = &quot;0.1.7&quot; AND KmLegacyRoyalMain017 AND KmLegacyRoyalUninstall017) OR (KmLegacyCefDisplayVersion = &quot;0.1.8&quot; AND KmLegacyRoyalMain018 AND KmLegacyRoyalUninstall018 AND KmLegacyCefSpriteManifest) OR (KmLegacyCefDisplayVersion = &quot;0.1.9&quot; AND KmLegacyRoyalMain019 AND KmLegacyRoyalUninstall019 AND KmLegacyCefSpriteManifest) OR (KmLegacyCefDisplayVersion = &quot;0.2.0&quot; AND KmLegacyRoyalMain020 AND KmLegacyRoyalUninstall020 AND KmLegacyCefSpriteManifest))) OR (KmLegacyCefPublisher = &quot;Matroskin&quot; AND ((KmLegacyCefDisplayVersion = &quot;0.2.1&quot; AND KmLegacyRoyalMain021 AND KmLegacyRoyalUninstall021 AND KmLegacyCefSpriteManifest) OR (KmLegacyCefDisplayVersion = &quot;0.2.2&quot; AND KmLegacyRoyalMain022 AND KmLegacyRoyalUninstall022 AND KmLegacyCefSpriteManifest) OR (KmLegacyCefDisplayVersion = &quot;0.3.21&quot; AND KmLegacyRoyalMain0321 AND KmLegacyRoyalUninstall0321 AND KmLegacyCefSpriteManifest) OR (KmLegacyCefDisplayVersion = &quot;0.4.26&quot; AND KmLegacyRoyalMain0426 AND KmLegacyRoyalUninstall0426 AND KmLegacyCefSpriteManifest))))" />
    <SetProperty Action="ValidateKmLegacyCefPokemonPayload"
                 Id="KmLegacyCefPokemonPayloadValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyCefRoyalPayload"
                 Condition="KM_REMOVE_LEGACY = 1 AND KM_LEGACY_CEF_VALID = 1 AND KmLegacyCefPublisher = &quot;KotMatrosk1n&quot; AND KmLegacyPokemonMainElectron AND KmLegacyCefAppArchive AND KmLegacyCefUpdaterConfig AND ((KmLegacyCefDisplayName = &quot;Pokemon Royal Sword 0.1.0&quot; AND KmLegacyCefDisplayVersion = &quot;0.1.0&quot; AND KmLegacyPokemonUninstall010) OR (KmLegacyCefDisplayName = &quot;Pokemon Royal Sword 0.1.1&quot; AND KmLegacyCefDisplayVersion = &quot;0.1.1&quot; AND KmLegacyPokemonUninstall011) OR (KmLegacyCefDisplayName = &quot;Pokemon Royal Sword 0.1.2&quot; AND KmLegacyCefDisplayVersion = &quot;0.1.2&quot; AND KmLegacyPokemonUninstall012))" />
    <SetProperty Action="ValidateKmLegacyCefRoyalIdentity"
                 Id="KmLegacyCefRoyalIdentityValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyCefPokemonPayload"
                 Condition="KmLegacyCefRoyalPayloadValidated = 1 AND KmLegacyCefInstallLocation ~= KmLegacyCefRoyalRoot AND KmLegacyCefUninstallCommand ~= KmLegacyCefRoyalCanonicalUninstallCommand" />
    <SetProperty Action="ValidateKmLegacyCefPokemonIdentity"
                 Id="KmLegacyCefPokemonIdentityValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyCefRoyalIdentity"
                 Condition="KmLegacyCefPokemonPayloadValidated = 1 AND KmLegacyCefInstallLocation ~= KmLegacyCefPokemonRoot AND KmLegacyCefUninstallCommand ~= KmLegacyCefPokemonCanonicalUninstallCommand" />
    <SetProperty Action="ValidateKmLegacyCefRoyalAtPokemonIdentity"
                 Id="KmLegacyCefRoyalAtPokemonIdentityValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyCefPokemonIdentity"
                 Condition="KmLegacyCefRoyalPayloadValidated = 1 AND KmLegacyCefInstallLocation ~= KmLegacyCefPokemonRoot AND KmLegacyCefUninstallCommand ~= KmLegacyCefRoyalAtPokemonUninstallCommand" />
    <SetProperty Action="ValidateKmLegacyCefRoyalNestedIdentity"
                 Id="KmLegacyCefRoyalNestedIdentityValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyCefRoyalAtPokemonIdentity"
                 Condition="KmLegacyCefRoyalPayloadValidated = 1 AND KmLegacyCefInstallLocation ~= KmLegacyCefRoyalNestedRoot AND KmLegacyCefUninstallCommand ~= KmLegacyCefRoyalNestedUninstallCommand" />
    <SetProperty Action="ValidateKmLegacyCefIdentity"
                 Id="KmLegacyCefIdentityValidated"
                 Value="1"
                 Sequence="execute"
                 After="ValidateKmLegacyCefRoyalNestedIdentity"
                 Condition="KmLegacyCefRoyalIdentityValidated = 1 OR KmLegacyCefPokemonIdentityValidated = 1 OR KmLegacyCefRoyalAtPokemonIdentityValidated = 1 OR KmLegacyCefRoyalNestedIdentityValidated = 1" />
    <CustomAction Id="BlockUnvalidatedLegacyCefInstall"
                  Error="A Royal Sword Calculator installation or leftover program folder was detected but cannot be removed safely. Uninstall it from Windows Settings, or remove its leftover Program Files folder if it is no longer registered, then run KM Calculator Setup again. After KM Calculator installs successfully, setup removes the remaining Royal Sword Calculator data for the current Windows user." />
    <InstallExecuteSequence>
      <Custom Action="BlockUnvalidatedLegacyCefInstall"
              After="ValidateKmLegacyCefIdentity"
              Condition="KM_REMOVE_LEGACY = 1 AND (KmLegacyCefRoyalCanonicalRootPresent OR KmLegacyCefPokemonCanonicalRootPresent OR KmLegacyCefRoyalNestedRootPresent OR KmLegacyCefInstallLocation OR KmLegacyCefDisplayName OR KmLegacyCefPublisher OR KmLegacyCefDisplayVersion OR KmLegacyCefUninstallCommand) AND (NOT KmLegacyCefIdentityValidated OR (KmLegacyCefRoyalCanonicalRootPresent AND NOT KmLegacyCefRoyalIdentityValidated) OR (KmLegacyCefPokemonCanonicalRootPresent AND NOT (KmLegacyCefPokemonIdentityValidated OR KmLegacyCefRoyalAtPokemonIdentityValidated OR KmLegacyCefRoyalNestedIdentityValidated)) OR (KmLegacyCefRoyalNestedRootPresent AND NOT KmLegacyCefRoyalNestedIdentityValidated))" />
    </InstallExecuteSequence>
    <ComponentGroup Id="KmCalculatorLegacyMigrationComponents">
      <Component Id="KmCalculatorLegacyCefMigrationComponent"
                 Directory="INSTALLFOLDER"
                 Guid="deb65f11-dab3-4d6a-a15f-85f596f60e1b"
                 Bitness="always64"
                 Transitive="yes"
                 Condition="KmLegacyCefRoyalIdentityValidated = 1 OR KmLegacyCefPokemonIdentityValidated = 1 OR KmLegacyCefRoyalAtPokemonIdentityValidated = 1 OR KmLegacyCefRoyalNestedIdentityValidated = 1">
        <util:RemoveFolderEx Id="RemoveValidatedLegacyCefRoyalInstallRoot"
                             Property="KmLegacyCefRoyalRoot"
